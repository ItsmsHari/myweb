## 10. CI/CD PIPELINE (Jenkins/GitHub Actions)

### 10.1 GitHub Actions Workflow

.github/workflows/deploy.yml:
```yaml
name: Build and Deploy

on:
  push:
    branches: [ master ]
  pull_request:
    branches: [ master ]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v2

    - name: Set up Java
      uses: actions/setup-java@v2
      with:
        java-version: '11'

    - name: Build with Maven
      run: mvn clean package

    - name: Run Tests
      run: mvn test

    - name: SonarCloud Scan
      uses: SonarSource/sonarcloud-github-action@master
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}

    - name: Build Docker Image
      run: |
        docker build -t myweb:${{ github.sha }} .
        docker tag myweb:${{ github.sha }} myweb:latest

    - name: Push to Registry
      run: |
        docker login -u ${{ secrets.REGISTRY_USERNAME }} \
          -p ${{ secrets.REGISTRY_PASSWORD }}
        docker push myweb:${{ github.sha }}

    - name: Deploy to Production
      if: github.ref == 'refs/heads/master'
      run: |
        kubectl set image deployment/myweb \
          myweb=myweb:${{ github.sha }} -n myweb
```

### 10.2 Jenkins Pipeline

Jenkinsfile:
```groovy
pipeline {
    agent any

    environment {
        REGISTRY = 'myregistry.azurecr.io'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Code Quality') {
            steps {
                sh 'mvn sonar:sonar'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${REGISTRY}/myweb:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    sh "docker push ${REGISTRY}/myweb:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    sh "kubectl set image deployment/myweb myweb=${REGISTRY}/myweb:${IMAGE_TAG} -n myweb"
                }
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
            archiveArtifacts artifacts: 'target/*.jar'
        }
    }
}
```

